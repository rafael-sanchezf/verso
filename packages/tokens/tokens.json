{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Design tokens exported from the Verso Figma file (Foundations page). $value is the light value; $extensions.verso.modes carries light and dark; $extensions.verso.css is the CSS custom property name Tailwind v4 and Uniwind consume. Regenerate from Figma rather than editing by hand, with packages/tokens/scripts/export-figma-variables.js.",
  "color": {
    "medium": {
      "games": {
        "$type": "color",
        "$value": "#439550",
        "$description": "Games. Harmonized direction, OKLCH L 0.60 C 0.13 light, L 0.67 C 0.112 dark. Retired by decision 29 (2026-10-08): code uses brand/*.",
        "$extensions": {
          "verso": {
            "figma": "medium/games",
            "css": "--color-medium-games",
            "modes": {
              "light": "#439550",
              "dark": "#64A86C"
            }
          }
        }
      },
      "books": {
        "$type": "color",
        "$value": "#B56D13",
        "$description": "Books. Retired by decision 29 (2026-10-08): code uses brand/*.",
        "$extensions": {
          "verso": {
            "figma": "medium/books",
            "css": "--color-medium-books",
            "modes": {
              "light": "#B56D13",
              "dark": "#C58545"
            }
          }
        }
      },
      "movies": {
        "$type": "color",
        "$value": "#4881CC",
        "$description": "Movies. Retired by decision 29 (2026-10-08): code uses brand/*.",
        "$extensions": {
          "verso": {
            "figma": "medium/movies",
            "css": "--color-medium-movies",
            "modes": {
              "light": "#4881CC",
              "dark": "#6697D9"
            }
          }
        }
      },
      "tv": {
        "$type": "color",
        "$value": "#9A67B8",
        "$description": "TV. Retired by decision 29 (2026-10-08): code uses brand/*.",
        "$extensions": {
          "verso": {
            "figma": "medium/tv",
            "css": "--color-medium-tv",
            "modes": {
              "light": "#9A67B8",
              "dark": "#AC80C7"
            }
          }
        }
      }
    },
    "bg": {
      "canvas": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$description": "Screen background.",
        "$extensions": {
          "verso": {
            "figma": "bg/canvas",
            "css": "--color-bg-canvas",
            "modes": {
              "light": "#FFFFFF",
              "dark": "#000000"
            }
          }
        }
      },
      "surface": {
        "$type": "color",
        "$value": "#F2F2F7",
        "$description": "Cards, sheets, chips.",
        "$extensions": {
          "verso": {
            "figma": "bg/surface",
            "css": "--color-bg-surface",
            "modes": {
              "light": "#F2F2F7",
              "dark": "#1C1C1E"
            }
          }
        }
      },
      "placeholder": {
        "$type": "color",
        "$value": "#E5E5EA",
        "$description": "Cover placeholders and skeletons.",
        "$extensions": {
          "verso": {
            "figma": "bg/placeholder",
            "css": "--color-bg-placeholder",
            "modes": {
              "light": "#E5E5EA",
              "dark": "#2C2C2E"
            }
          }
        }
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "#000000",
        "$description": "Primary text and active icons.",
        "$extensions": {
          "verso": {
            "figma": "text/primary",
            "css": "--color-text-primary",
            "modes": {
              "light": "#000000",
              "dark": "#FFFFFF"
            }
          }
        }
      },
      "secondary": {
        "$type": "color",
        "$value": "#6E6E73",
        "$description": "Secondary text and inactive icons.",
        "$extensions": {
          "verso": {
            "figma": "text/secondary",
            "css": "--color-text-secondary",
            "modes": {
              "light": "#6E6E73",
              "dark": "#98989F"
            }
          }
        }
      },
      "destructive": {
        "$type": "color",
        "$value": "#BB0A10",
        "$description": "Destructive and error text: Sign out, Delete account, field errors, destructive menu items. Light #BB0A10 (6.6:1 on white). Dark #FF453A, iOS's dark-mode red (6.2:1 on black, 5.0:1 on #1C1C1E). Not a verdict: tier/disliked is the verdict. Added 2026-10-08.",
        "$extensions": {
          "verso": {
            "figma": "text/destructive",
            "css": "--color-text-destructive",
            "modes": {
              "light": "#BB0A10",
              "dark": "#FF453A"
            }
          }
        }
      }
    },
    "border": {
      "separator": {
        "$type": "color",
        "$value": "#C6C6C8",
        "$description": "Hairlines.",
        "$extensions": {
          "verso": {
            "figma": "border/separator",
            "css": "--color-border-separator",
            "modes": {
              "light": "#C6C6C8",
              "dark": "#38383A"
            }
          }
        }
      }
    },
    "tier": {
      "loved": {
        "$type": "color",
        "$value": "#006822",
        "$description": "Loved it. #006822 in both modes, the brand green (option A, decision 29, 2026-10-07; supersedes the 2026-09-16 palette). Label is tier/label. Chip icon: heart.",
        "$extensions": {
          "verso": {
            "figma": "tier/loved",
            "css": "--color-tier-loved",
            "modes": {
              "light": "#006822",
              "dark": "#006822"
            }
          }
        }
      },
      "liked": {
        "$type": "color",
        "$value": "#5B6C00",
        "$description": "Liked it. #5B6C00 in both modes (option A, decision 29, 2026-10-07). Label is tier/label. Chip icon: thumbs-up.",
        "$extensions": {
          "verso": {
            "figma": "tier/liked",
            "css": "--color-tier-liked",
            "modes": {
              "light": "#5B6C00",
              "dark": "#5B6C00"
            }
          }
        }
      },
      "fine": {
        "$type": "color",
        "$value": "#865900",
        "$description": "It was fine. #865900 in both modes (option A, decision 29, 2026-10-07). Label is tier/label. Chip icon: meh.",
        "$extensions": {
          "verso": {
            "figma": "tier/fine",
            "css": "--color-tier-fine",
            "modes": {
              "light": "#865900",
              "dark": "#865900"
            }
          }
        }
      },
      "disliked": {
        "$type": "color",
        "$value": "#BB0A10",
        "$description": "Didn't like it. #BB0A10 in both modes (option A, decision 29, 2026-10-07). Label is tier/label. Chip icon: thumbs-down.",
        "$extensions": {
          "verso": {
            "figma": "tier/disliked",
            "css": "--color-tier-disliked",
            "modes": {
              "light": "#BB0A10",
              "dark": "#BB0A10"
            }
          }
        }
      },
      "label": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$description": "White text and icons on every tier chip, divider chip and score badge, both modes: 5.8 to 7.0:1 on the four option A solids and every score blend between them (decision 29, 2026-10-07).",
        "$extensions": {
          "verso": {
            "figma": "tier/label",
            "css": "--color-tier-label",
            "modes": {
              "light": "#FFFFFF",
              "dark": "#FFFFFF"
            }
          }
        }
      }
    },
    "brand": {
      "primary": {
        "$type": "color",
        "$value": "#006822",
        "$description": "The brand green, decision 29 (2026-10-07). Fill for primary buttons, the selected medium, filled controls, in both modes; labels on it are brand/on-primary (7.0:1). Replaces medium/* in code.",
        "$extensions": {
          "verso": {
            "figma": "brand/primary",
            "css": "--color-brand-primary",
            "modes": {
              "light": "#006822",
              "dark": "#006822"
            }
          }
        }
      },
      "on-primary": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$description": "Labels and icons on brand/primary, both modes (7.0:1). Decision 29 (2026-10-07).",
        "$extensions": {
          "verso": {
            "figma": "brand/on-primary",
            "css": "--color-brand-on-primary",
            "modes": {
              "light": "#FFFFFF",
              "dark": "#FFFFFF"
            }
          }
        }
      },
      "text": {
        "$type": "color",
        "$value": "#006822",
        "$description": "Brand-colored text and icons on the canvas: the active tab, links, checks. Light #006822 (7.0:1 on white). Dark #009B37 (5.7:1 on black), lifted because #006822 is 3.0:1 on black; the dark value is open item 1 (#64A86C the alternative). Decision 29 (2026-10-07).",
        "$extensions": {
          "verso": {
            "figma": "brand/text",
            "css": "--color-brand-text",
            "modes": {
              "light": "#006822",
              "dark": "#009B37"
            }
          }
        }
      },
      "tint-half": {
        "$type": "color",
        "$value": "#80B491",
        "$description": "Half tint of the brand green, from the logo handoff (the play triangle in the mark). Decision 29.",
        "$extensions": {
          "verso": {
            "figma": "brand/tint-half",
            "css": "--color-brand-tint-half",
            "modes": {
              "light": "#80B491",
              "dark": "#80B491"
            }
          }
        }
      },
      "tint-quarter": {
        "$type": "color",
        "$value": "#CDE8D3",
        "$description": "Quarter tint of the brand green, from the logo handoff. Decision 29.",
        "$extensions": {
          "verso": {
            "figma": "brand/tint-quarter",
            "css": "--color-brand-tint-quarter",
            "modes": {
              "light": "#CDE8D3",
              "dark": "#CDE8D3"
            }
          }
        }
      }
    }
  },
