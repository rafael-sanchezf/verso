{
  "name": "@verso/tokens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.json": "./tokens.json",
    "./theme.css": "./theme.css"
  },
  "files": [
    "src",
    "tokens.json",
    "theme.css"
  ],
  "scripts": {
    "build": "node scripts/build-theme.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "check": "node scripts/build-theme.mjs && git diff --exit-code -- src/theme.ts theme.css"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
