# Secrets and local env
.env
.env.*
!.env.example

# macOS
.DS_Store

# Node / pnpm
node_modules/
.pnpm-store/
*.tsbuildinfo

# Expo / React Native (native dirs are generated by prebuild)
.expo/
dist/
web-build/
ios/
android/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Metro / caches
.metro-health-check*
.turbo/
.cache/

# Supabase local
supabase/.branches
supabase/.temp
supabase/.env

# Deno, which runs the Edge Functions. `deno test supabase/functions/...` drops
# a lock file wherever it is run from; the versions the functions pin live in
# their import specifiers, so the lock is a local cache and not a source file.
deno.lock

# Editors
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Agent worktrees created by Claude Code
.claude/worktrees/

# The Jira CLI's cache of account ids (scripts/jira/README.md)
scripts/jira/.jira-cache.json
