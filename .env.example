# Copy to .env and fill in. Never commit .env.
# The mobile app never receives server-side secrets; these are for the backend, scripts, and local tooling.

# IGDB via Twitch (client credentials flow). Register your own application
# (docs/design/igdb-setup.md); the client ID is not secret, the secret is.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# The hosted Supabase project; <project-ref> is its ref (dashboard: Connect panel and API settings).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Database password, read by the Supabase CLI for link, migrations, and db commands.
SUPABASE_DB_PASSWORD=
# Session pooler URI from the dashboard's Connect panel, used by the catalog
# mirror (packages/catalog). The direct host is IPv6-only, so the pooler is the
# one that works from a laptop and from GitHub Actions.
# postgresql://postgres.<project-ref>:[PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Steam Web API (V1). Not read from here: the Steam library import runs in an
# Edge Function, so the key lives in the function's own secrets and never in the
# app bundle or this file. Rafa's step, once:
#   supabase secrets set STEAM_WEB_API_KEY=...
# Get the key at https://steamcommunity.com/dev/apikey (a non-limited account, a
# domain -- `localhost` is accepted for development -- and the mobile
# authenticator; docs/research/game-data-sources.md 4.1). The OpenID login in
# supabase/functions/steam-link needs no key at all; only the import does.
# The name is listed here so `.env.example` stays the index of every secret.
STEAM_WEB_API_KEY=
# Also Edge Function secrets, and also not read from here. Same reason they are
# listed: this file is the index of every secret, wherever it actually lives.
# steam-link's own public URL. Required: it is the OpenID realm Valve shows the
# user and the base of every return_to, so deriving it from the incoming request
# would let a forged Host header choose both. The function refuses to start a
# link without it.
#   supabase secrets set STEAM_LINK_RETURN_URL=https://<project-ref>.supabase.co/functions/v1/steam-link
STEAM_LINK_RETURN_URL=
# Where the browser is sent when the round trip ends. Optional: defaults to
# verso://steam/linked, the app's scheme (apps/mobile/app.json). Set it only if
# the scheme changes.
#   supabase secrets set STEAM_LINK_APP_REDIRECT=verso://steam/linked
STEAM_LINK_APP_REDIRECT=
# Local development only, and never set on a deployed project: `true` lets
# steam-link fall back to deriving its return_to and OpenID realm from the
# incoming request, which relaxes the pin above and lets a forged Host header
# choose both. Leave it unset unless you are running the function locally.
STEAM_LINK_ALLOW_REQUEST_RETURN_TO=

# OpenCritic's official API, distributed through RapidAPI (work queue item 14).
# Subscribe to the free Basic plan on
# https://rapidapi.com/opencritic-opencritic-default/api/opencritic-api and copy
# the X-RapidAPI-Key from the dashboard. Free tier: 200 requests and 25 searches
# a day. The catalog's `opencritic-scores` command uses only id lookups, never
# the search endpoint, and skips with a message when this is unset, so leaving
# it blank is a supported state rather than a broken one. The companion
# `wikidata-ids` command, which fills the ids it spends, needs no key at all:
# it reads Wikidata.
OPENCRITIC_RAPIDAPI_KEY=
# IsThereAnyDeal (V1 "where to play"). Optional: without it the `availability`
# command runs the Game Pass and GeForce NOW sources and skips IsThereAnyDeal
# with one log line. Create an app at https://isthereanydeal.com/apps/my/.
# Also add it as the ITAD_API_KEY repository secret for the Availability workflow.
ITAD_API_KEY=

# TMDB, the film and TV catalog (V3). Create a free account at
# https://www.themoviedb.org/signup, request an API key of type "Developer" at
# https://www.themoviedb.org/settings/api (a short form asking for an
# application name, URL and summary), and copy the **API Read Access Token**
# from that same settings page -- the v4 bearer token, not the v3 api_key,
# because the bearer works on every v3 route and keeps one credential in play.
# Also add it as the TMDB_API_READ_ACCESS_TOKEN repository secret for the TMDB
# sync workflow. The `tmdb-sync` command skips with one log line when this is
# unset, so leaving it blank is a supported state rather than a broken one, and
# the daily id exports the same command reads are public files that need no
# credential at all. Steps and terms in docs/design/tmdb-setup.md.
TMDB_API_READ_ACCESS_TOKEN=

# Local tooling only, read by apps/mobile/scripts/brand-assets.mjs and
# apps/site/scripts/brand-assets.mjs, which render the icons and the share
# image in a headless Chromium. All three are optional: the scripts find
# Playwright and Chromium on their own.
# A playwright package to use instead of the one in the npx cache.
PLAYWRIGHT_DIR=
# A Chromium binary to use instead of the one in Playwright's cache.
CHROMIUM_PATH=
# A path: when set, the site's script also writes the bare 1024 px icon there.
ICON_CHECK=

# EAS cloud builds (runbook section 8) never see this file: the two EXPO_PUBLIC_
# values the app reads (apps/mobile/.env.example) are EAS environment variables on
# the Expo project, set 2026-10-06 for development, preview and production.

# Anthropic API key for the suggest Edge Function: a function secret (runbook section 7), never in the app.
ANTHROPIC_API_KEY=
# Optional suggest settings, also function secrets, shown at their defaults.
# The model must accept adaptive thinking with an effort level (Claude Haiku
# 5.5, Sonnet 5.5, Opus 5.5 and the other current models; not Haiku 4.5) or
# every request falls back to SQL's picks. The limit is requests per user per
# 24 hours; 0 turns suggestions off.
SUGGEST_MODEL=claude-haiku-5-5
SUGGEST_DAILY_LIMIT=20

# The Jira board (docs/process/jira.md), read by scripts/jira/jira: the site's host, the Claude account's email, and that account's API token.
JIRA_SITE=<site>.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
